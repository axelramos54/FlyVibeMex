@*
 ============================================================================================
 Views/Shared/_Layout.cshtml — plantilla COMÚN del sitio público.
 La usan todas las vistas que no declaran Layout (ver Views/_ViewStart.cshtml): Home, Miusuario, Solicitar, Otros
 y las páginas nuevas del catálogo. Las pantallas de acceso (IniciarSesion, Crearusuario) siguen
 siendo páginas independientes (Layout = null) y el panel interno usa Views/Admin/_AdminLayout.cshtml.
 Las páginas de error (Views/Estado/*) eligen este layout o el del panel según la zona (EstadoViewModel.Layout).

 T7 (31-10-2026): barra con botón ☰ en pantallas chicas (navbar-expand-lg), header "sticky" (ya no tapa el
 contenido), marca con logo (_Marca), mensajes comunes (_Mensajes) y footer con enlaces y contacto editable.

 Cada vista puede agregar:
   @section Styles  { <link rel="stylesheet" href="~/assets/css/style_X.css"> }   → dentro de <head>
   @section Scripts { <script src="~/assets/js/script_X.js"></script> }          → al final del <body>, DESPUÉS de Bootstrap

 Antes de esta fecha el sitio era una "SPA casera" (Home/Index.cshtml + cargarPagina() de script.js): la URL no cambiaba,
 no servía el botón Atrás y los <script> de cada sección no se ejecutaban. Ahora cada sección es una página con su URL.
 ============================================================================================
*@
@inject IContenidoSitioService ContenidoServicio
@{
    // Contenido editable por el SA (en caché; si la BD no responde se usan los textos por defecto).
    var contenidoSitio = await ContenidoServicio.ObtenerAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string titulo ? $"{titulo} - FlyVibeMex" : "FlyVibeMex")</title>
    @* Bootstrap 5.3.8 desde wwwroot/lib (ver _BootstrapCss.cshtml: en una feria, un CDN caído = sitio sin estilos). *@
    <partial name="_BootstrapCss" />
    @* Hoja global: navbar, header, contenedor principal, mensajes y footer. *@
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true">
    <partial name="_Favicon" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* ---- Barra de navegación (T7.4): en pantallas de menos de 992 px las secciones se esconden tras el botón ☰.
         El header es sticky (no fixed): ocupa su lugar en la página, así que nunca tapa el contenido. ---- *@
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg" id="navbar" aria-label="Secciones del sitio">
            <div class="container-fluid px-0">
                <img src="/assets/img/logo.jpg" alt="logo" width="50px" style="margin-right: 1rem; height: 50px; border-radius: 50%; object-fit: cover;">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand" id="navbar_left"><partial name="_Marca" /></a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu_principal"
                        aria-controls="menu_principal" aria-expanded="false" aria-label="Abrir o cerrar el menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu_principal">
                    <div class="navbar-nav ms-auto" id="navbar_right">
                        <a class="m-1" asp-controller="Home" asp-action="Index">Inicio</a>
                        <a class="m-1" asp-controller="Home" asp-action="Viajes">Vuelos</a>
                        <a class="m-1" asp-controller="Home" asp-action="Hoteles">Hoteles</a>
                        <a class="m-1" asp-controller="Home" asp-action="Vehiculos">Vehículos</a>
                        <a class="m-1" asp-controller="Home" asp-action="Tours">Tours</a>
                        <a class="m-1" asp-controller="Home" asp-action="Paquetes">Paquetes</a>
                        @* Sesión: "Iniciar sesión" o el menú del usuario (Views/Shared/_MenuUsuario.cshtml). *@
                        <partial name="_MenuUsuario" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido_main">
        @* Mensajes de TempData (Exito / Aviso / Error), incluido el que deja ErroresBaseDatosFilter cuando la BD falla.
           Las vistas ya NO los pintan por su cuenta (T7.5). *@
        @{ ViewData["MensajesClase"] = "container mt-3"; }
        <partial name="_Mensajes" />
        @RenderBody()
    </main>

    @* ---- Pie de página (T7.3). Texto, correo y teléfono los edita el SA en Contenido del sitio › Pie de página. ---- *@
    @{
        var correoContacto = contenidoSitio.Texto(ContenidoSitioClaves.PieCorreo);
        var telefonoContacto = contenidoSitio.Texto(ContenidoSitioClaves.PieTelefono);
    }
    <footer>
        <div class="container">
            <nav class="d-flex flex-wrap justify-content-center gap-3 mb-2" aria-label="Información del sitio">
                <a asp-controller="Otros" asp-action="Politicas">Políticas</a>
                <a asp-controller="Otros" asp-action="Politicas" asp-fragment="privacidad">Aviso de privacidad</a>
                <a asp-controller="Solicitar" asp-action="Index">Soporte</a>
            </nav>
            @if (!string.IsNullOrWhiteSpace(correoContacto) || !string.IsNullOrWhiteSpace(telefonoContacto))
            {
                <p class="mb-2">
                    @if (!string.IsNullOrWhiteSpace(correoContacto))
                    {
                        <a href="mailto:@correoContacto">@correoContacto</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(correoContacto) && !string.IsNullOrWhiteSpace(telefonoContacto))
                    {
                        <span aria-hidden="true"> · </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(telefonoContacto))
                    {
                        <a href="tel:@ContenidoSitioClaves.SoloDigitosTelefono(telefonoContacto)">@telefonoContacto</a>
                    }
                </p>
            }
            @* El año se pone solo. *@
            <p class="mb-0" style="white-space: pre-line">&copy; @DateTime.Now.Year @contenidoSitio.Texto(ContenidoSitioClaves.PieTexto)</p>
        </div>
    </footer>

    @* JS de Bootstrap (dropdowns, modales…). Los scripts de cada vista van DESPUÉS, en la sección Scripts. *@
    <partial name="_BootstrapJs" />
    @* Validación en el navegador + "Procesando…" en los botones (T6.1). *@
    @* Validación en el navegador + "Procesando…" en los botones (T6.1).
       L3a: una página que no tiene NINGÚN formulario declara ViewData["SinValidacion"] = true y se ahorra los
       ~131 KB de jQuery + validation, que en un equipo antiguo cuestan parseo en CADA carga.
       Es un opt-OUT a propósito: por omisión la validación se carga, así que una página nueva nunca la pierde
       por olvido. La lista de páginas sin formulario se calculó resolviendo los <partial> de forma transitiva
       (una vista sin <form> propio puede incluir un parcial que sí lo tiene, como _ModalesCancelacion). *@
    @if (ViewData["SinValidacion"] is not true)
    {
        <partial name="_ValidationScriptsPartial" />
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
