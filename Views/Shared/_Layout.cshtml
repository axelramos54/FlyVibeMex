@*
 ============================================================================================
 Views/Shared/_Layout.cshtml — plantilla COMÚN del sitio público.
 La usan todas las vistas que no declaran Layout (ver Views/_ViewStart.cshtml): Home, Miusuario, Solicitar, Otros
 y las páginas nuevas del catálogo. Las pantallas de acceso (IniciarSesion, Crearusuario, AccesoDenegado) siguen
 siendo páginas independientes (Layout = null) y el panel interno usa Views/Admin/_AdminLayout.cshtml.

 Cada vista puede agregar:
   @section Styles  { <link rel="stylesheet" href="~/assets/css/style_X.css"> }   → dentro de <head>
   @section Scripts { <script src="~/assets/js/script_X.js"></script> }          → al final del <body>, DESPUÉS de Bootstrap

 Antes de esta fecha el sitio era una "SPA casera" (Home/Index.cshtml + cargarPagina() de script.js): la URL no cambiaba,
 no servía el botón Atrás y los <script> de cada sección no se ejecutaban. Ahora cada sección es una página con su URL.
 ============================================================================================
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string titulo ? $"{titulo} - FlyVibeMex" : "FlyVibeMex")</title>
    @* Bootstrap 5.3.8 desde CDN (las copias locales de wwwroot/lib solo contienen archivos LICENSE). *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    @* Hoja global: navbar, header fijo, contenedor principal y footer. *@
    <link rel="stylesheet" href="~/assets/css/style.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* ---- Barra de navegación (header fijo, ver #navbar en style.css) ---- *@
    <header>
        <section class="navbar" id="navbar">
            <div class="navbar-collapse d-flex">
                @* Marca: regresa al inicio desde cualquier página. TODO: agregar el logo (wwwroot/assets/img/). *@
                <div class="navbar-brand d-flex" id="navbar_left">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none"><p class="m-1">FlyVibeMex</p></a>
                </div>

                <nav class="navbar-item ms-auto d-flex flex-wrap" id="navbar_right" aria-label="Secciones del sitio">
                    <a class="m-1" asp-controller="Home" asp-action="Index">Inicio</a>
                    <a class="m-1" asp-controller="Home" asp-action="Viajes">Vuelos</a>
                    <a class="m-1" asp-controller="Home" asp-action="Hoteles">Hoteles</a>
                    <a class="m-1" asp-controller="Home" asp-action="vehiculos">Vehículos</a>
                    <a class="m-1" asp-controller="Home" asp-action="Tours">Tours</a>
                    <a class="m-1" asp-controller="Home" asp-action="Paquetes">Paquetes</a>
                    @* Sesión: "Iniciar sesión" o el menú del usuario (Views/Shared/_MenuUsuario.cshtml). *@
                    <partial name="_MenuUsuario" />
                </nav>
            </div>
        </section>
    </header>

    <main id="contenido_main">
        @RenderBody()
    </main>

    <footer>
        <p class="mb-1">&copy; @DateTime.Now.Year FlyVibeMex · Proyecto integrador</p>
        <a asp-controller="Otros" asp-action="Politicas" class="text-reset">Políticas</a>
    </footer>

    @* JS de Bootstrap (dropdowns, modales…). Los scripts de cada vista van DESPUÉS, en la sección Scripts. *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
