@*
 ============================================================================================
 Views/Crearusuario/Index.cshtml — GET/POST /Crearusuario (CrearusuarioController.Index)
 Pantalla del prototipo: Cuenta › Registro ("Crear nueva cuenta").
 Página COMPLETA (Layout = null: pantalla de acceso independiente). Se llega desde el enlace
 "Crear nueva cuenta" del formulario de inicio de sesión (Views/Home/_FormSesion.cshtml).
 Estilos: wwwroot/assets/css/style_C.css (letra C = Crear usuario).
 Seguridad: POST con token antiforgery; la contraseña viaja solo en este formulario y se guarda como hash.
 ============================================================================================
*@
@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Crear nueva cuenta";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear nueva cuenta - FlyVibeMex</title>
    <partial name="_BootstrapCss" />
    <link rel="stylesheet" href="~/assets/css/style_C.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/campo_password.css" asp-append-version="true">
    <partial name="_Favicon" />
</head>

<body>
    <div class="container card" id="tarjeta_registro">
        <a asp-controller="Home" asp-action="Index" id="marca_registro" class="d-flex justify-content-center align-items-center gap-2 text-decoration-none"><partial name="_Marca" /></a>
        <h1 id="titulo_registro" class="text-center">Crear nueva cuenta</h1>
        <p id="subtitulo_registro" class="text-center">Regístrate para reservar y consultar tus viajes.</p>

        <form asp-controller="Crearusuario" asp-action="Index" method="post" id="formu_registro">
            @if (ViewData.ModelState.TryGetValue(string.Empty, out var errorGeneral) && errorGeneral.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    @foreach (var error in errorGeneral.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            @* A dónde volver al terminar (lo valida el controlador con Url.IsLocalUrl). *@
            <input type="hidden" asp-for="returnUrl" />

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="nombre" class="form-label"></label>
                    <input asp-for="nombre" class="form-control" maxlength="80" autocomplete="given-name" required />
                    <span asp-validation-for="nombre" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="apellido_paterno" class="form-label"></label>
                    <input asp-for="apellido_paterno" class="form-control" maxlength="60" autocomplete="family-name" required />
                    <span asp-validation-for="apellido_paterno" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="apellido_materno" class="form-label"></label>
                    <input asp-for="apellido_materno" class="form-control" maxlength="60" required />
                    <span asp-validation-for="apellido_materno" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="correo" class="form-label"></label>
                    @* data-validar-al-salir: el aviso de correo ya registrado ([Remote]) se consulta al salir del campo, no en
                       cada tecla (script_password.js). En la feria todos salen por la misma IP y el límite es de 20 por minuto. *@
                    <input asp-for="correo" type="email" class="form-control" maxlength="150" placeholder="ejemplo@gmail.com" autocomplete="email" required data-validar-al-salir />
                    <span asp-validation-for="correo" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="telefono" class="form-label"></label>
                    <input asp-for="telefono" type="tel" class="form-control" maxlength="20" placeholder="961 123 4567" autocomplete="tel" required />
                    <span asp-validation-for="telefono" class="text-danger small"></span>
                </div>

                @* Botón "Ver" DENTRO del recuadro (wwwroot/assets/css/campo_password.css + js/script_password.js).
                   type="button": no envía el formulario y el "Procesando…" de script_validacion.js no lo toca. *@
                <div class="col-sm-6">
                    <label asp-for="password" class="form-label"></label>
                    <div class="campo-password">
                        <input asp-for="password" type="password" class="form-control" minlength="8" maxlength="128" autocomplete="new-password" required aria-describedby="requisitos_password" />
                        <button type="button" class="btn-ver-password" data-ver-password aria-controls="password"><span data-texto-ver>Ver</span><span class="visually-hidden"> contraseña</span></button>
                    </div>
                    <span asp-validation-for="password" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="confirmar_password" class="form-label"></label>
                    <div class="campo-password">
                        <input asp-for="confirmar_password" type="password" class="form-control" minlength="8" maxlength="128" autocomplete="new-password" required />
                        <button type="button" class="btn-ver-password" data-ver-password aria-controls="confirmar_password"><span data-texto-ver>Ver</span><span class="visually-hidden"> confirmación de contraseña</span></button>
                    </div>
                    <span asp-validation-for="confirmar_password" class="text-danger small"></span>
                </div>

                @* Requisitos de la contraseña: los MISMOS de CrearUsuarioViewModel.password ([StringLength] 8–128 y
                   [RegularExpression] letra + número). script_password.js los marca en vivo y toca el DOM solo cuando un
                   requisito cambia de estado. Sin JavaScript se leen como texto de ayuda. *@
                <div class="col-12">
                    <ul id="requisitos_password" class="requisitos-password" data-campo="password" aria-live="polite">
                        <li data-requisito="longitud" data-cumple="false" aria-atomic="true"><span class="visually-hidden estado-requisito">Pendiente: </span>Entre 8 y 128 caracteres</li>
                        <li data-requisito="letra" data-cumple="false" aria-atomic="true"><span class="visually-hidden estado-requisito">Pendiente: </span>Al menos una letra</li>
                        <li data-requisito="numero" data-cumple="false" aria-atomic="true"><span class="visually-hidden estado-requisito">Pendiente: </span>Al menos un número</li>
                    </ul>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        @* data-msg-required: con la casilla sin marcar, el navegador muestra este mensaje en lugar del genérico
                           (unobtrusive no usa data-val-required en casillas; ver wwwroot/assets/js/script_validacion.js). *@
                        <input asp-for="acepto_terminos" class="form-check-input" required
                               data-msg-required="Debes aceptar los términos para crear tu cuenta." />
                        <label asp-for="acepto_terminos" class="form-check-label"></label>
                        (<a asp-controller="Otros" asp-action="Politicas" target="_blank" rel="noopener">ver políticas</a>)
                    </div>
                    <span asp-validation-for="acepto_terminos" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" id="btn_registrar" class="w-100">Crear cuenta</button>
        </form>

        <p id="ya_tengo_cuenta" class="text-center mb-0">
            ¿Ya tienes cuenta?
            <a asp-controller="Home" asp-action="IniciarSesion" asp-route-returnUrl="@Model.returnUrl">Inicia sesión</a>
        </p>
    </div>
    @* Validación en el navegador + "Procesando…" (T6.1). *@
    <partial name="_ValidationScriptsPartial" />
    @* Botón "Ver", requisitos en vivo y [Remote] al salir del campo. Va DESPUÉS de la validación: usa su validador. *@
    <script src="~/assets/js/script_password.js" asp-append-version="true"></script>
</body>

</html>
