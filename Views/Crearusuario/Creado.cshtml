@*
 Views/Crearusuario/Creado.cshtml — GET /Crearusuario/Creado (CrearusuarioController.Creado)
 Confirmación después de crear la cuenta. El mensaje que dejó el POST en TempData (Exito o Aviso) lo pinta
 Views/Shared/_Mensajes.cshtml (T7.5). Si alguien entra directo (sin TempData), se muestra un mensaje genérico.
 Leer TempData aquí y en el parcial en la MISMA petición devuelve el mismo valor (se borra al terminar la petición).
*@
@{
    ViewData["Title"] = "Cuenta creada";
    Layout = null;
    var exito = TempData["Exito"] as string;
    var aviso = TempData["Aviso"] as string;
    var nombre = TempData["NombreNuevo"] as string;
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cuenta creada - FlyVibeMex</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="~/assets/css/style_C.css" asp-append-version="true">
    <partial name="_Favicon" />
</head>

<body>
    <div class="container card text-center" id="tarjeta_registro">
        <a asp-controller="Home" asp-action="Index" id="marca_registro" class="d-flex justify-content-center align-items-center gap-2 text-decoration-none"><partial name="_Marca" /></a>

        <div id="icono_creado" aria-hidden="true">✓</div>

        <h1 id="titulo_registro">
            @(string.IsNullOrEmpty(nombre) ? "¡Bienvenido!" : $"¡Bienvenido, {nombre}!")
        </h1>

        <partial name="_Mensajes" />
        @if (exito is null && aviso is null)
        {
            <p id="subtitulo_registro">Si ya creaste tu cuenta, inicia sesión para continuar.</p>
        }

        <div class="d-grid gap-2 mt-3">
            <a asp-controller="Home" asp-action="IniciarSesion" id="btn_registrar" class="btn">Iniciar sesión</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Ir al inicio</a>
        </div>
    </div>
    @* JS de Bootstrap: lo necesita el botón ✕ de los mensajes. *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
</body>

</html>
