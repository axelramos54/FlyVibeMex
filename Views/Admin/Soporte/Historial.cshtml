@* GET /Admin/Soporte/Historial: tickets propios ya cerrados. *@
@model List<TicketPanelItem>
@{
    ViewData["SinValidacion"] = true;   // L3a: esta página no tiene ningún formulario
    ViewData["Title"] = "Mi historial de tickets";
}

<h1 class="h3 mb-3">Mi historial de tickets</h1>
<p class="text-muted">Tickets que ya atendiste y cerraste (los 200 más recientes).</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <strong>No hay tickets en tu historial.</strong> Aquí aparecerán los tickets que cierres.
    </div>
}
else
{
    <partial name="~/Views/Admin/Soporte/_TablaTickets.cshtml" model="Model" />
}
