@* GET /Admin/Soporte/NuevoTicket (SoporteController.NuevoTicket): el ticket ABIERTO sin agente más antiguo.
   Solo se lee; "Tomar este ticket" es un POST (Tomar/{id}) con UPDATE condicional. *@
@model TicketDetalleViewModel
@{
    ViewData["Title"] = "Atender nuevo ticket";
}

@if (Model is null)
{
    <h1 class="h3 mb-3">Atender nuevo ticket</h1>
    <div class="alert alert-info">
        <strong>No hay tickets que atender.</strong> Por el momento no hay solicitudes pendientes de asignar.
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al panel de soporte</a>
}
else
{
    <div class="alert alert-light border small">
        Siguiente en la fila (el más antiguo). Hay <strong>@Model.EnFila</strong> ticket(s) esperando agente.
    </div>
    <partial name="~/Views/Admin/Soporte/_DetalleTicket.cshtml" model="Model" />
}
