@{
    ViewData["Title"] = "Panel de administración";
}

@section Menu {
    <a class="m-1" asp-controller="Soporte" asp-action="Index">Soporte</a>
    <a class="m-1" asp-controller="Gestor" asp-action="Index">Gestor Ventas</a>
    <a class="m-1" asp-controller="SA" asp-action="Index">SA</a>
    <a class="m-1" asp-controller="Home" asp-action="Index">Ir al sitio</a>
}

<div class="p-4 mb-4 bg-light border rounded-3">
    <h1 class="h2">Panel de administración</h1>
    <p class="lead mb-1">Estás en el área interna de FlyVibeMex.</p>
    <p class="mb-0 text-muted">
        Desde aquí entras a las herramientas de cada área. Elige la sección que te corresponde
        en las tarjetas de abajo o en el menú superior.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Soporte</h2>
                <p class="card-text">Atiende los tickets de los clientes, da seguimiento a los que tienes en curso y consulta tu historial.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Soporte" asp-action="Index">Entrar a Soporte</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Gestor de ventas</h2>
                <p class="card-text">Da de alta y administra proveedores, paquetes y promociones.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Gestor" asp-action="Index">Entrar a Gestor de ventas</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">SA</h2>
                <p class="card-text">Administración general del sistema.</p>
                <a class="btn btn-primary mt-auto" asp-controller="SA" asp-action="Index">Entrar a SA</a>
            </div>
        </div>
    </div>
</div>

<p class="text-muted small mt-4 mb-0">Esta área es solo para personal autorizado de FlyVibeMex.</p>
