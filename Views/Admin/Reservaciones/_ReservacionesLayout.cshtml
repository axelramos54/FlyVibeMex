@* Layout del panel de Reservaciones y reembolsos: define su menú y se mete dentro del layout general del admin. *@
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Seccion"] = "Reservaciones";
    ViewData["SeccionUrl"] = Url.Action("Index", "ReservacionesPanel");
}

@section Menu {
    <a class="m-1" asp-controller="ReservacionesPanel" asp-action="Index">Reservaciones</a>
    <a class="m-1" asp-controller="ReservacionesPanel" asp-action="Reembolsos" asp-route-vista="pendientes">Reembolsos pendientes</a>
    <a class="m-1" asp-controller="ReservacionesPanel" asp-action="Reembolsos" asp-route-vista="todos">Todos los reembolsos</a>
    <a class="m-1" asp-controller="Admin" asp-action="Index">Regresar</a>
}

@RenderBody()

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
