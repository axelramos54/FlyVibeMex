@*
    Layout base de todo el panel administrativo.
    - El menú de la derecha lo pone cada panel con  @section Menu { ... }
    - El contenido de cada pantalla aparece donde está @RenderBody()
    - T7 (31-10-2026): barra con botón ☰ (navbar-expand-lg) y header sticky como el sitio público; a la derecha el
      mismo menú del usuario que el sitio (_MenuUsuario: nombre, Mi perfil, Cerrar sesión); mensajes con _Mensajes.
*@
@{
    var seccion = ViewData["Seccion"] as string;       // lo define el layout de cada panel (Soporte, SA, Gestor)
    var seccionUrl = ViewData["SeccionUrl"] as string;
    var titulo = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@titulo - Admin FlyVibeMex</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true">
    <partial name="_Favicon" />
</head>

<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg" id="navbar" aria-label="Secciones del panel">
            <div class="container-fluid px-0">
                <a asp-controller="Admin" asp-action="Index" class="navbar-brand" id="navbar_left">
                    <partial name="_Marca" /><span class="etiqueta-panel">Panel</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu_panel"
                        aria-controls="menu_panel" aria-expanded="false" aria-label="Abrir o cerrar el menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu_panel">
                    <div class="navbar-nav ms-auto" id="navbar_right">
                        @await RenderSectionAsync("Menu", required: false)
                        <partial name="_MenuUsuario" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">
        @* Migas de pan: le dicen al usuario en qué pantalla está *@
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Panel de administración</a></li>
                @if (seccion is not null)
                {
                    <li class="breadcrumb-item"><a href="@seccionUrl">@seccion</a></li>
                }
                @if (titulo is not null && titulo != seccion && titulo != "Panel de administración")
                {
                    <li class="breadcrumb-item active" aria-current="page">@titulo</li>
                }
            </ol>
        </nav>

        @* Mensajes que dejan los controladores después de guardar algo (TempData Exito / Aviso / Error, T7.5) *@
        <partial name="_Mensajes" />
        @if (ViewData["SinBD"] is true)
        {
            <div class="alert alert-secondary small">
                <strong>Modo prueba:</strong> todavía no hay conexión a la base de datos, por eso esta pantalla
                se muestra con datos vacíos o de prueba.
            </div>
        }
    </div>

    <main id="contenido_main" class="container mb-5">
        @RenderBody()
    </main>

    <footer>
        <p class="mb-0">&copy; @DateTime.Now.Year FlyVibeMex · Panel interno</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    @* Validación en el navegador + "Procesando…" en los botones (T6.1). *@
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
