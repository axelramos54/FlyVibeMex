@* Layout del panel SA: define su menú y se mete dentro del layout general del admin. *@
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Seccion"] = "SA";
    ViewData["SeccionUrl"] = Url.Action("Index", "SA");
}

@section Menu {
    <a class="m-1" asp-controller="SA" asp-action="Estadisticas">Estadísticas</a>
    <a class="m-1" asp-controller="SA" asp-action="Usuarios">Usuarios</a>
    <a class="m-1" asp-controller="SA" asp-action="ListaRoles">Roles</a>
    <a class="m-1" asp-controller="SA" asp-action="Ubicaciones">Ubicaciones</a>
    <a class="m-1" asp-controller="SA" asp-action="MetodosPago">Métodos de pago</a>
    <a class="m-1" asp-controller="SA" asp-action="Bancos">Bancos</a>
    <a class="m-1" asp-controller="SA" asp-action="Bitacora">Bitácora</a>
    <a class="m-1" asp-controller="SA" asp-action="Contenido">Contenido del sitio</a>
    <a class="m-1" asp-controller="Admin" asp-action="Index">Regresar</a>
}

@RenderBody()

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
