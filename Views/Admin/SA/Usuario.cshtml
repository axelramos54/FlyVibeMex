@* GET /Admin/SA/Usuarios/{id} (SAController.Usuario): datos, rol, estado y contraseña de una cuenta + sus
   movimientos en la bitácora. Protecciones: el SA no se cambia el rol, no se desactiva ni se restablece la contraseña
   a sí mismo, y siempre debe quedar un SA activo (lo valida el servidor). *@
@model UsuarioEdicionViewModel
@{
    ViewData["Title"] = Model.correo;
    var es = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Datos.nombre @Model.Datos.apellido_paterno</h1>
        <div class="text-muted small">
            @Model.correo · alta el @Model.creado_en.ToString("dd/MM/yyyy", es)
            · @Model.reservaciones reservación(es) · @Model.tickets ticket(s)
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge fs-6 text-bg-primary">@Model.rol</span>
        @if (Model.activo)
        {
            <span class="badge fs-6 text-bg-success">Activa</span>
        }
        else
        {
            <span class="badge fs-6 text-bg-secondary">Inactiva</span>
        }
    </div>
</div>

@if (Model.EsPropia)
{
    <div class="alert alert-info small">Es tu cuenta: puedes editar tus datos, pero no cambiar tu rol, desactivarte ni restablecer tu contraseña aquí (usa Mi perfil).</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="GuardarDatosUsuario" asp-route-id="@Model.id" method="post" class="card card-body" novalidate>
            <h2 class="h5">Datos</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Datos.nombre" class="form-label"></label>
                    <input asp-for="Datos.nombre" class="form-control" maxlength="80" />
                    <span asp-validation-for="Datos.nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Datos.apellido_paterno" class="form-label"></label>
                    <input asp-for="Datos.apellido_paterno" class="form-control" maxlength="60" />
                    <span asp-validation-for="Datos.apellido_paterno" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Datos.apellido_materno" class="form-label"></label>
                    <input asp-for="Datos.apellido_materno" class="form-control" maxlength="60" />
                    <span asp-validation-for="Datos.apellido_materno" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label for="correo_fijo" class="form-label">Correo</label>
                    <input id="correo_fijo" class="form-control" value="@Model.correo" readonly />
                    <div class="form-text">El correo no se cambia.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Datos.telefono" class="form-label"></label>
                    <input asp-for="Datos.telefono" class="form-control" maxlength="20" />
                    <span asp-validation-for="Datos.telefono" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Guardar datos</button>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Rol</h2>
                @if (Model.EsPropia)
                {
                    <p class="small text-muted mb-0">No puedes cambiar tu propio rol.</p>
                }
                else
                {
                    <form asp-action="CambiarRolUsuario" asp-route-id="@Model.id" method="post">
                        <div class="input-group">
                            <select name="rol" class="form-select" asp-items="Model.Roles" aria-label="Rol"></select>
                            <button type="submit" class="btn btn-outline-primary">Cambiar</button>
                        </div>
                        <div class="form-text">Si tiene la sesión abierta, se cierra en su siguiente clic.</div>
                    </form>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Estado</h2>
                @if (Model.EsPropia)
                {
                    <p class="small text-muted mb-0">No puedes desactivar tu propia cuenta.</p>
                }
                else
                {
                    <form asp-action="CambiarEstadoUsuario" asp-route-id="@Model.id" method="post">
                        <input type="hidden" name="activo" value="@(Model.activo ? "false" : "true")" />
                        @if (Model.activo)
                        {
                            <button type="submit" class="btn btn-outline-danger w-100">Desactivar cuenta</button>
                            <div class="form-text">Ya no podrá iniciar sesión; sus compras y tickets se conservan.</div>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-success w-100">Activar cuenta</button>
                        }
                    </form>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h6">Contraseña</h2>
                @if (Model.EsPropia)
                {
                    <p class="small text-muted mb-0">Tu contraseña se cambia en Mi perfil.</p>
                }
                else
                {
                    <form asp-action="RestablecerContrasena" asp-route-id="@Model.id" method="post">
                        <button type="submit" class="btn btn-outline-warning w-100">Restablecer contraseña</button>
                        <div class="form-text">Genera una contraseña temporal (se muestra una vez); la anterior deja de servir.</div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<h2 class="h5 mt-4">Cambios a esta cuenta</h2>
@if (Model.Movimientos.Count == 0)
{
    <p class="text-muted small">Sin cambios registrados.</p>
}
else
{
    <partial name="~/Views/Admin/SA/_TablaBitacora.cshtml" model="Model.Movimientos" />
}

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Usuarios">Volver a usuarios</a>
</div>
