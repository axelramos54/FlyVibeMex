@model Proveedores
@{
    ViewData["Title"] = "Dar de baja proveedor";
    var paso = ViewData["Paso"] as int? ?? 1;
}

<h1 class="h3 mb-3">Dar de baja proveedor</h1>

<div class="card mb-3" style="max-width: 760px">
    <div class="card-body">
        <partial name="~/Views/Admin/GestorVentas/_ProveedorResumen.cshtml" model="Model" />
    </div>
</div>

<div style="max-width: 760px">
    @if (paso == 1)
    {
        <div class="alert alert-warning">
            <strong>Confirmación 1 de 2.</strong>
            ¿Seguro que quieres dar de baja a <strong>@Model.nombre</strong>?
            El proveedor quedará inactivo y ya no se le podrán asociar servicios nuevos.
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-danger" asp-action="DarDeBaja" asp-route-id="@Model.id" asp-route-paso="2">Sí, continuar</a>
            <a class="btn btn-outline-secondary" asp-action="GestionarProveedores" asp-route-nombre="@Model.nombre">Cancelar</a>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Confirmación 2 de 2.</strong>
            Esta es la confirmación final. Al aceptar, <strong>@Model.nombre</strong> se dará de baja.
        </div>

        @* La baja modifica datos: va por POST con token antiforgery (lo agrega el tag helper del form) *@
        <form asp-action="ConfirmarBaja" asp-route-id="@Model.id" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="confirmo" name="confirmo" value="true" required />
                <label class="form-check-label" for="confirmo">
                    Confirmo que quiero dar de baja a @Model.nombre
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Dar de baja definitivamente</button>
                <a class="btn btn-outline-secondary" asp-action="GestionarProveedores" asp-route-nombre="@Model.nombre">Cancelar</a>
            </div>
        </form>
    }
</div>
