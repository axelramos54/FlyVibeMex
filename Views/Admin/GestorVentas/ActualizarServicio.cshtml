@*
 GET  /Admin/GestorVentas/Servicios/{id}/Actualizar (GestorController.ActualizarServicio)
 POST /Admin/GestorVentas/Servicios/{id}/Actualizar (GestorController.GuardarActualizacion)
 Se edita todo menos el tipo. Las compras ya hechas conservan su precio y su política (snapshot, regla R4).
*@
@model FormServicioViewModel
@{
    var f = Model.Formulario!;
    ViewData["Title"] = "Actualizar servicio";
}

<h1 class="h3 mb-1">Actualizar @TiposGestor.Nombre(f.Slug).ToLower()</h1>
<p class="text-muted">
    Modifica la información y presiona Guardar cambios. Las reservaciones ya hechas no cambian
    (conservan el precio y la política con la que se compraron). El cupo por fecha se cambia en <strong>Disponibilidad</strong>.
</p>

<partial name="~/Views/Admin/GestorVentas/_FormServicio.cshtml" model="f" />
