@*
 Views/Admin/GestorVentas/Promociones.cshtml — GET /Admin/GestorVentas/Promociones (GestorController.GestionarPromociones)
 Listado de promociones (tabla promociones) por estado: vigentes, próximas, vencidas, inactivas o todas.
 Las promociones no se anuncian: el cliente escribe el código al comprar. Nunca se borran, se desactivan.
*@
@model ListaPromocionesViewModel
@{
    ViewData["Title"] = "Promociones";
    var ahora = DateTime.Now;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Promociones</h1>
        <p class="text-muted mb-0">Códigos de descuento que el cliente escribe en el resumen de compra.</p>
    </div>
    <a class="btn btn-primary" asp-action="Promociones">+ Nueva promoción</a>
</div>

<ul class="nav nav-tabs mb-3">
    @foreach (var (valor, texto) in ListaPromocionesViewModel.Estados)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Estado == valor ? "active" : "")" asp-action="GestionarPromociones"
               asp-route-estado="@valor" asp-route-codigo="@Model.Codigo">@texto</a>
        </li>
    }
</ul>

<form method="get" asp-action="GestionarPromociones" class="card card-body mb-3">
    <input type="hidden" name="estado" value="@Model.Estado" />
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label for="codigo" class="form-label">Código</label>
            <input id="codigo" name="codigo" value="@Model.Codigo" class="form-control" maxlength="30" placeholder="Buscar por código" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
        </div>
    </div>
</form>

@if (Model.Resultados.Count == 0)
{
    <div class="alert alert-info">
        No hay promociones en esta lista. <a asp-action="Promociones" class="alert-link">Crea una</a>.
    </div>
}
else
{
    <p class="text-muted small mb-2">@Model.Resultados.Count promoción(es)</p>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Descuento</th>
                    <th class="text-end">Compra mínima</th>
                    <th>Vigencia</th>
                    <th>Estado</th>
                    <th class="text-end">Servicios</th>
                    <th class="text-end">Usos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Resultados)
                {
                    var estado = p.Estado(ahora);
                    var badge = estado switch
                    {
                        "Vigente" => "text-bg-success",
                        "Próxima" => "text-bg-info",
                        "Vencida" => "text-bg-warning",
                        _ => "text-bg-secondary"
                    };
                    <tr class="@(p.activo ? "" : "table-secondary")">
                        <td>
                            <div class="fw-semibold font-monospace">@p.codigo</div>
                            @if (!string.IsNullOrEmpty(p.nombre))
                            {
                                <div class="small text-muted">@p.nombre</div>
                            }
                        </td>
                        <td class="text-nowrap">@p.TextoDescuento</td>
                        <td class="text-end text-nowrap">
                            @if (p.minimo_compra > 0)
                            {
                                <span>$@p.minimo_compra.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="small text-nowrap">
                            @p.fecha_inicio.ToString("dd/MM/yyyy HH:mm")<br />
                            @p.fecha_fin.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td><span class="badge @badge">@estado</span></td>
                        <td class="text-end">@p.servicios</td>
                        <td class="text-end">@p.usos</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-primary" asp-action="ActualizarPromocion" asp-route-id="@p.id">Actualizar</a>
                                <form asp-action="CambiarEstadoPromocion" asp-route-id="@p.id" method="post" class="d-inline">
                                    <input type="hidden" name="activo" value="@(p.activo ? "false" : "true")" />
                                    <input type="hidden" name="estado" value="@Model.Estado" />
                                    @if (p.activo)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
