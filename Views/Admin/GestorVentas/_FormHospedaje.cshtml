@* Datos del hospedaje (tabla hospedajes). Los incluye _FormServicio.cshtml. La imagen se guarda como archivo en
   wwwroot/uploads/hospedajes/ y en la BD solo va su ruta (imagen_ruta). *@
@model HospedajeFormViewModel
@{
    var ubicaciones = ViewData["Ubicaciones"] as List<SelectListItem> ?? new List<SelectListItem>();
}

<h3 class="h6">Datos del hospedaje</h3>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="id_ubicacion" class="form-label"></label>
        <select asp-for="id_ubicacion" asp-items="ubicaciones" class="form-select" required>
            <option value="">— Selecciona —</option>
        </select>
        <span asp-validation-for="id_ubicacion" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="tipo_habitacion" class="form-label"></label>
        <input asp-for="tipo_habitacion" class="form-control" maxlength="60" placeholder="Sencilla, doble, suite, cabaña..." required />
        <span asp-validation-for="tipo_habitacion" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="categoria" class="form-label"></label>
        <input asp-for="categoria" class="form-control" maxlength="40" placeholder="4 estrellas, boutique..." />
        <span asp-validation-for="categoria" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="capacidad_huespedes" class="form-label"></label>
        <input asp-for="capacidad_huespedes" type="number" min="1" max="1000" class="form-control" required />
        <div class="form-text">Huéspedes por habitación (el catálogo calcula cuántas habitaciones se necesitan).</div>
        <span asp-validation-for="capacidad_huespedes" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="hora_entrada" class="form-label"></label>
        <input asp-for="hora_entrada" type="time" asp-format="{0:HH:mm}" class="form-control" required />
        <span asp-validation-for="hora_entrada" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="hora_salida" class="form-label"></label>
        <input asp-for="hora_salida" type="time" asp-format="{0:HH:mm}" class="form-control" required />
        <span asp-validation-for="hora_salida" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="imagen" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.imagen_actual))
        {
            <div class="d-flex align-items-center gap-3 mb-2">
                <img src="@Model.imagen_actual" alt="Imagen actual" class="rounded border object-fit-cover" style="width: 120px; height: 80px" />
                <div class="form-check">
                    <input asp-for="quitar_imagen" class="form-check-input" />
                    <label asp-for="quitar_imagen" class="form-check-label"></label>
                </div>
            </div>
        }
        <input asp-for="imagen" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
        <div class="form-text">JPG, PNG o WEBP, máximo 2 MB.@(string.IsNullOrEmpty(Model.imagen_actual) ? "" : " Si eliges otra, reemplaza a la actual.")</div>
        <span asp-validation-for="imagen" class="text-danger small"></span>
    </div>
</div>
