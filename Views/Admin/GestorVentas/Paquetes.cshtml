@*
 Views/Admin/GestorVentas/Paquetes.cshtml — GET /Admin/GestorVentas/Paquetes (GestorController.GestionarPaquetes)
 Listado de paquetes (servicios tipo PAQUETE) con su destino, duración, personas y lo que incluyen.
 Baja / reactivación y disponibilidad usan las mismas pantallas que los demás servicios.
*@
@model ListaPaquetesViewModel
@{
    ViewData["Title"] = "Paquetes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Paquetes</h1>
        <p class="text-muted mb-0">Combinaciones de servicios que el cliente compra en una sola reservación.</p>
    </div>
    <a class="btn btn-primary" asp-action="CrearPaquete">+ Crear paquete</a>
</div>

<form method="get" asp-action="GestionarPaquetes" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label for="nombre" class="form-label">Nombre</label>
            <input id="nombre" name="nombre" value="@Model.Nombre" class="form-control" maxlength="150" placeholder="Buscar por nombre" />
        </div>
        <div class="col-md-3">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="incluirInactivos" name="incluirInactivos" value="true" checked="@Model.IncluirInactivos" />
                <label class="form-check-label" for="incluirInactivos">Incluir inactivos</label>
            </div>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
        </div>
    </div>
</form>

@if (Model.Resultados.Count == 0)
{
    <div class="alert alert-info">
        No hay paquetes que coincidan con el filtro. <a asp-action="CrearPaquete" class="alert-link">Crea uno</a>.
    </div>
}
else
{
    <p class="text-muted small mb-2">@Model.Resultados.Count paquete(s)</p>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Paquete</th>
                    <th>Destino</th>
                    <th>Duración</th>
                    <th>Personas</th>
                    <th>Incluye</th>
                    <th class="text-end">Precio / persona</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Resultados)
                {
                    var s = p.Servicio;
                    <tr class="@(s.activo ? "" : "table-secondary")">
                        <td>
                            <div class="fw-semibold">@s.nombre</div>
                            <div class="small text-muted">@p.proveedor</div>
                        </td>
                        <td class="small">
                            @if (string.IsNullOrEmpty(p.destino))
                            {
                                <span class="text-danger">Sin destino</span>
                            }
                            else
                            {
                                <span>@p.destino</span>
                                if (!p.destino_explicito)
                                {
                                    <div class="text-muted">(de sus servicios)</div>
                                }
                            }
                        </td>
                        <td class="text-nowrap">@p.duracion_dias día(s)</td>
                        <td class="text-nowrap">@p.min_personas – @p.max_personas</td>
                        <td class="small">
                            @if (p.componentes.Count == 0)
                            {
                                <span class="text-danger">Nada</span>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var comp in p.componentes)
                                    {
                                        <li>@comp</li>
                                    }
                                </ul>
                            }
                        </td>
                        <td class="text-end text-nowrap">$@s.precio_base.ToString("N2") @s.moneda</td>
                        <td>
                            @if (s.activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                                if (p.dias_con_cupo == 0)
                                {
                                    <div class="small text-danger">Sin cupo: no aparece en el sitio</div>
                                }
                                else
                                {
                                    <div class="small text-muted">@p.dias_con_cupo día(s) con cupo</div>
                                }
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-primary" asp-action="ActualizarPaquete" asp-route-id="@s.id">Actualizar</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Disponibilidad" asp-route-id="@s.id">Disponibilidad</a>
                                @if (s.activo)
                                {
                                    <a class="btn btn-sm btn-outline-danger" asp-action="DarDeBajaServicio" asp-route-id="@s.id">Dar de baja</a>
                                }
                                else
                                {
                                    <form asp-action="ReactivarServicio" asp-route-id="@s.id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
