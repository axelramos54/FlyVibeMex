@*
 GET/POST /Admin/GestorVentas/Paquetes/Crear            (GestorController.CrearPaquete / GuardarPaquete)
 GET/POST /Admin/GestorVentas/Paquetes/{id}/Actualizar  (GestorController.ActualizarPaquete / GuardarCambiosPaquete)
 Paquete = servicios (tipo PAQUETE) + paquete + paquete_servicio (+ disponibilidad inicial en el alta).
 Precio y cupo propios (por persona y por día); los servicios incluidos son su contenido y no descuentan su cupo.
*@
@model PaqueteFormViewModel
@{
    ViewData["Title"] = Model.EsAlta ? "Crear paquete" : "Actualizar paquete";
    var ubicaciones = ViewData["Ubicaciones"] as List<SelectListItem> ?? new List<SelectListItem>();
}

<h1 class="h3 mb-1">@ViewData["Title"]</h1>
<p class="text-muted">
    Combina vuelos, hospedajes, vehículos y tours en una sola compra. El cliente paga el precio del paquete
    (por persona) y aparta lugares del cupo del paquete.
    @if (!Model.EsAlta)
    {
        <span>Las compras ya hechas no cambian.</span>
    }
</p>

<form asp-action="@(Model.EsAlta ? "GuardarPaquete" : "GuardarCambiosPaquete")" asp-route-id="@(Model.EsAlta ? null : Model.id.ToString())"
      method="post" enctype="multipart/form-data" class="card card-body" style="max-width: 1000px" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="~/Views/Admin/GestorVentas/_ServicioCampos.cshtml" model="Model" />
    <div class="form-text">En un paquete, el precio base y el precio por día son <strong>por persona</strong>.</div>

    <hr class="my-4" />
    <h3 class="h6">Datos del paquete</h3>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="duracion_dias" class="form-label"></label>
            <input asp-for="duracion_dias" type="number" min="1" max="365" class="form-control" required />
            <span asp-validation-for="duracion_dias" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="min_personas" class="form-label"></label>
            <input asp-for="min_personas" type="number" min="1" max="500" class="form-control" required />
            <span asp-validation-for="min_personas" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="max_personas" class="form-label"></label>
            <input asp-for="max_personas" type="number" min="1" max="500" class="form-control" required />
            <span asp-validation-for="max_personas" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="id_ubicacion_destino" class="form-label"></label>
            <select asp-for="id_ubicacion_destino" asp-items="ubicaciones" class="form-select">
                <option value="">— Deducirlo de sus servicios —</option>
            </select>
            <div class="form-text">
                Si lo dejas así, se usa la ciudad de su hospedaje o el destino de su vuelo. Es obligatorio si los servicios
                están en ciudades distintas o si no incluye hospedaje ni vuelo.
            </div>
            <span asp-validation-for="id_ubicacion_destino" class="text-danger small"></span>
        </div>

    </div>

    @* Imagen: parcial común a los cinco tipos de servicio (L6b). *@
    <partial name="~/Views/Admin/GestorVentas/_ImagenServicioCampos.cshtml" model="Model" />

    @* ---- Servicios incluidos ---- *@
    <hr class="my-4" />
    <h3 class="h6">Servicios incluidos</h3>
    <p class="small text-muted mb-2">
        Marca lo que incluye el paquete. Cantidad = cuánto incluye de ese servicio (p. ej. 3 noches, 3 días de auto, 1 vuelo);
        orden = cómo se muestran en el detalle. Solo aparecen servicios activos (y los que ya tenía).
    </p>
    <span asp-validation-for="componentes" class="text-danger small d-block mb-2"></span>

    <div data-seleccion>
        @if (Model.Candidatos.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No hay servicios activos para incluir. <a asp-action="AltaServicio" class="alert-link">Da de alta</a> vuelos,
                hospedajes, vehículos o tours primero.
            </div>
        }
        else
        {
            <partial name="~/Views/Admin/GestorVentas/_FiltrosSeleccion.cshtml" model="Model.Candidatos" />
            <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light position-sticky top-0">
                        <tr>
                            <th style="width: 40px"></th>
                            <th>Servicio</th>
                            <th>Tipo</th>
                            <th>Proveedor</th>
                            <th style="width: 110px">Cantidad</th>
                            <th style="width: 90px">Orden</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Candidatos.Count; i++)
                        {
                            var c = Model.Candidatos[i];
                            var texto = $"{c.nombre} {c.detalle} {c.proveedor}".ToLowerInvariant();
                            <tr data-tipo="@c.tipo_servicio" data-proveedor="@c.id_proveedor" data-texto="@texto">
                                <td>
                                    <input type="hidden" asp-for="componentes[i].id_servicio" />
                                    <input asp-for="componentes[i].incluido" class="form-check-input" data-marca
                                           aria-label="@($"Incluir {c.nombre}")" />
                                </td>
                                <td>
                                    <div class="fw-semibold">@c.nombre</div>
                                    @if (!string.IsNullOrEmpty(c.detalle))
                                    {
                                        <div class="small text-muted">@c.detalle</div>
                                    }
                                    @if (!c.activo)
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="small">@ServicioFormViewModel.NombreTipo(c.tipo_servicio)</td>
                                <td class="small">@c.proveedor</td>
                                <td><input asp-for="componentes[i].cantidad" type="number" step="0.01" min="0.01" class="form-control form-control-sm" /></td>
                                <td><input asp-for="componentes[i].orden" type="number" min="0" max="999" class="form-control form-control-sm" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.EsAlta)
    {
        <hr class="my-4" />
        <partial name="~/Views/Admin/GestorVentas/_InventarioInicialCampos.cshtml" model="Model" />
    }

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary">@(Model.EsAlta ? "Crear paquete" : "Guardar cambios")</button>
        @if (!Model.EsAlta)
        {
            <a class="btn btn-outline-primary" asp-action="Disponibilidad" asp-route-id="@Model.id">Disponibilidad</a>
        }
        <a class="btn btn-outline-secondary" asp-action="GestionarPaquetes">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script src="~/assets/js/script_seleccion_servicios.js"></script>
}
