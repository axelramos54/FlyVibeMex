@* GET/POST /Admin/GestorVentas/Servicios/{id}/Baja (GestorController.DarDeBajaServicio / ConfirmarBajaServicio)
   Doble confirmación, igual que la baja de proveedor. *@
@model ServicioDetalleViewModel
@{
    ViewData["Title"] = "Dar de baja servicio";
    var paso = ViewData["Paso"] as int? ?? 1;
    var s = Model.Servicio;
}

<h1 class="h3 mb-3">Dar de baja servicio</h1>

<div class="card mb-3" style="max-width: 760px">
    <div class="card-body">
        <partial name="~/Views/Admin/GestorVentas/_ServicioResumen.cshtml" model="Model" />
    </div>
</div>

<div style="max-width: 760px">
    @if (paso == 1)
    {
        <div class="alert alert-warning">
            <strong>Confirmación 1 de 2.</strong>
            ¿Seguro que quieres dar de baja <strong>@s.nombre</strong>?
            Dejará de mostrarse a los clientes y no se podrá reservar. Las reservaciones que ya existen no cambian.
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-danger" asp-action="DarDeBajaServicio" asp-route-id="@s.id" asp-route-paso="2">Sí, continuar</a>
            <a class="btn btn-outline-secondary" asp-action="ListaServicios">Cancelar</a>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Confirmación 2 de 2.</strong>
            Esta es la confirmación final. Al aceptar, <strong>@s.nombre</strong> se dará de baja.
            Podrás reactivarlo después desde el listado de servicios.
        </div>

        @* La baja modifica datos: va por POST con token antiforgery (lo agrega el tag helper del form) *@
        <form asp-action="ConfirmarBajaServicio" asp-route-id="@s.id" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="confirmo" name="confirmo" value="true" required />
                <label class="form-check-label" for="confirmo">
                    Confirmo que quiero dar de baja @s.nombre
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Dar de baja definitivamente</button>
                <a class="btn btn-outline-secondary" asp-action="ListaServicios">Cancelar</a>
            </div>
        </form>
    }
</div>
