@* Campos comunes de la tabla servicios. Los usan los formularios de hospedaje, vehículo y evento. *@
@model ServicioFormBase

<h3 class="h6">Datos del servicio</h3>
<div class="row g-3">
    <div class="col-12">
        <label asp-for="nombre" class="form-label"></label>
        <input asp-for="nombre" class="form-control" maxlength="150" required />
        <span asp-validation-for="nombre" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="descripcion" class="form-label"></label>
        <textarea asp-for="descripcion" class="form-control" rows="3" maxlength="2000"></textarea>
        <span asp-validation-for="descripcion" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="precio_base" class="form-label"></label>
        <input asp-for="precio_base" type="number" step="0.01" min="0" class="form-control" required />
        <span asp-validation-for="precio_base" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="moneda" class="form-label"></label>
        <select asp-for="moneda" asp-items="ServicioFormBase.OpcionesMoneda()" class="form-select"></select>
        <span asp-validation-for="moneda" class="text-danger small"></span>
    </div>
</div>
