@model ProveedorFormViewModel
@{
    ViewData["Title"] = "Dar de alta proveedor";
}

<h1 class="h3 mb-1">Dar de alta proveedor</h1>
<p class="text-muted">Captura la información del nuevo proveedor. Todos los campos marcados son obligatorios.</p>

<form asp-action="AltaProveedor" method="post" class="card card-body" style="max-width: 760px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="~/Views/Admin/GestorVentas/_ProveedorCampos.cshtml" model="Model" />

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Dar de alta</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
