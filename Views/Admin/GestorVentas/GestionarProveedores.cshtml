@model GestionarProveedoresViewModel
@{
    ViewData["Title"] = "Gestionar proveedores";
}

<h1 class="h3 mb-1">Gestionar proveedores</h1>
<p class="text-muted">Escribe el nombre del proveedor y presiona Buscar.</p>

@* Formulario GET: solo consulta, por eso no necesita token antiforgery *@
<form method="get" asp-action="GestionarProveedores" class="row g-2 mb-2" style="max-width: 760px">
    <div class="col">
        <label for="nombre" class="visually-hidden">Nombre del proveedor</label>
        <input id="nombre" name="nombre" value="@Model.Nombre" class="form-control"
               maxlength="120" placeholder="Nombre del proveedor" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>
<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (Model.Buscado)
{
    <h2 class="h5 mt-4">Resultado</h2>

    if (Model.Resultados.Count == 0)
    {
        <div class="alert alert-warning">
            No se encontró ningún proveedor con el nombre <strong>"@Model.Nombre"</strong>.
        </div>
    }

    foreach (var p in Model.Resultados)
    {
        <div class="card mb-3" style="max-width: 760px">
            <div class="card-body">
                <partial name="~/Views/Admin/GestorVentas/_ProveedorResumen.cshtml" model="p" />

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a class="btn btn-outline-primary" asp-action="Actualizar" asp-route-id="@p.id">Actualizar</a>
                    <a class="btn btn-outline-secondary" asp-action="ListaServicios" asp-route-idProveedor="@p.id" asp-route-incluirInactivos="true">Servicios</a>
                    @if (p.activo)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Asociar" asp-route-id="@p.id">Agregar servicio</a>
                        <a class="btn btn-outline-danger" asp-action="DarDeBaja" asp-route-id="@p.id">Dar de baja</a>
                    }
                    else
                    {
                        <form asp-action="ReactivarProveedor" asp-route-id="@p.id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-success">Reactivar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
}
