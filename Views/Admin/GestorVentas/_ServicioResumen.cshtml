@* Ficha con la información de un servicio (la usa "Dar de baja servicio"). *@
@model ServicioDetalleViewModel
@{
    var s = Model.Servicio;
}

<dl class="row mb-0">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@s.nombre</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@ServicioFormViewModel.NombreTipo(s.tipo_servicio)</dd>

    <dt class="col-sm-3">Proveedor</dt>
    <dd class="col-sm-9">@Model.NombreProveedor</dd>

    <dt class="col-sm-3">Precio base</dt>
    <dd class="col-sm-9">$@s.precio_base.ToString("N2") @s.moneda</dd>

    @if (!string.IsNullOrWhiteSpace(s.descripcion))
    {
        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@s.descripcion</dd>
    }

    <dt class="col-sm-3">Cancelación</dt>
    <dd class="col-sm-9">@(s.politica_cancelacion ?? PoliticaCancelacion.Describir(s.permite_cancelacion, s.horas_reembolso_total, s.porcentaje_reembolso_tardio))</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        @if (s.activo)
        {
            <span class="badge text-bg-success">Activo</span>
        }
        else
        {
            <span class="badge text-bg-secondary">Inactivo</span>
        }
    </dd>
</dl>
