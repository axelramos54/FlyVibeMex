@*
 ============================================================================================
 Vista: Views/Miusuario/Miscompras/index.cshtml   —   GET /Miusuario/Miscompras
 Movimientos de dinero de la cuenta: pagos (con tarjeta enmascarada y referencia) y reembolsos con su estado.
 Los viajes en sí (fechas, cancelar) están en Mis reservaciones; aquí cada código lleva a su detalle.
 ============================================================================================
*@
@model MisComprasViewModel
@{
    ViewData["Title"] = "Mis compras";
    ViewData["Pestana"] = "compras";
    var es = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    var cliente = Model.Contexto.IdClienteVisto?.ToString();

    string ClaseEstado(string estado) => estado switch
    {
        "APROBADO" or "PROCESADO" or "REEMBOLSADO" => "text-bg-success",
        "RECHAZADO" => "text-bg-danger",
        "SOLICITADO" or "PENDIENTE" => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}

<div class="container mt-2">
    <h1 class="h3 mb-3">Mis compras</h1>

    <partial name="~/Views/Miusuario/_CuentaNav.cshtml" model="Model.Contexto" />

    @* ---- Pagos ---- *@
    <section class="mb-5" aria-labelledby="titulo_pagos">
        <h2 class="h4 mb-3" id="titulo_pagos">Pagos</h2>
        @if (Model.Pagos.Count == 0)
        {
            <p class="text-muted">Todavía no hay pagos en esta cuenta.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Reserva</th>
                            <th>Servicio</th>
                            <th>Método</th>
                            <th>Estado</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pagos)
                        {
                            <tr>
                                <td class="text-nowrap">@p.fecha.ToString("dd/MM/yyyy HH:mm", es)</td>
                                <td>
                                    <a asp-action="Reservacion" asp-route-id="@p.codigo_reserva" asp-route-cliente="@cliente">@p.codigo_reserva</a>
                                </td>
                                <td>@p.servicio</td>
                                <td class="small">
                                    @p.metodo · @p.tarjeta
                                    @if (p.referencia is not null)
                                    {
                                        <div class="text-muted">Ref. @p.referencia</div>
                                    }
                                </td>
                                <td><span class="badge @ClaseEstado(p.estado)">@p.estado</span></td>
                                <td class="text-end text-nowrap">$@p.monto.ToString("N2") <small>@p.moneda</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ---- Reembolsos ---- *@
    <section class="mb-5" aria-labelledby="titulo_reembolsos">
        <h2 class="h4 mb-3" id="titulo_reembolsos">Reembolsos</h2>
        @if (Model.Reembolsos.Count == 0)
        {
            <p class="text-muted">No hay reembolsos. Para pedir uno, usa “Cancelar y reembolsar” en Mis reservaciones.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Solicitado</th>
                            <th>Reserva</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th>Resuelto</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rb in Model.Reembolsos)
                        {
                            <tr>
                                <td class="text-nowrap">@rb.fecha_solicitud.ToString("dd/MM/yyyy HH:mm", es)</td>
                                <td>
                                    <a asp-action="Reservacion" asp-route-id="@rb.codigo_reserva" asp-route-cliente="@cliente">@rb.codigo_reserva</a>
                                </td>
                                <td class="small">@rb.motivo</td>
                                <td><span class="badge @ClaseEstado(rb.estado)">@rb.estado</span></td>
                                <td class="text-nowrap">@(rb.fecha_resolucion?.ToString("dd/MM/yyyy", es) ?? "En revisión")</td>
                                <td class="text-end text-nowrap">$@rb.monto.ToString("N2") <small>@rb.moneda</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
