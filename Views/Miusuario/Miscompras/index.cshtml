@{
    ViewData["Title"] = "Mis compras";
}

    <!--maqueta toda rancia-->
   <h2>Mis compras</h2>

   <h3 id="viajes_actuales">Actuales</h3>

   <div>
                    <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 mi-tarjeta">
                    <div class="card-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80"
                             class="card-img-top" alt="Grand Oasis Cancún">
                        <div class="route-badge">
                            <span class="route-text">Cancún • 5★ All Inclusive</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Grand Oasis Cancún</h5>
                        <p class="card-text">Resort de playa con alberca estilo laguna, restaurantes de
                            especialidades y vista panorámica al mar Caribe.</p>
                            <div class="card-footer-box">
                                <div class="price-box">
                                    <span class="price-value">$3,250 <small>MXN</small></span>
                                </div>
                                <button type="button" class="btn btn-card-action" data-accion="cancelar" data-id="15" data-nombre="Grand Oasis Cancún">Cancelar</button>
                                <button type="button" class="btn btn-card-action" data-accion="reembolsar" data-id="15" data-nombre="Grand Oasis Cancún">Cancelar y reembolsar</button>
                                <a href="#" class="btn btn-card-action">⋮</a> <!-- aqui poner la politica de reembolso y otros datos-->
                            </div>
                        </div>
                    </div>
                </div>
   </div>
   <h3 id="viajes_pasados">Pasadas</h3>
   <div>
        <div>
                    <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 mi-tarjeta">
                    <div class="card-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80"
                             class="card-img-top" alt="Grand Oasis Cancún">
                        <div class="route-badge">
                            <span class="route-text">Cancún • 5★ All Inclusive</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Grand Oasis Cancún</h5>
                        <p class="card-text">Resort de playa con alberca estilo laguna, restaurantes de
                            especialidades y vista panorámica al mar Caribe.</p>
                            <div class="card-footer-box">
                                <div class="price-box">
                                    <span class="price-value">$3,250 <small>MXN</small></span>
                                </div>
            
                            </div>
                        </div>
                    </div>
                </div>
   </div>
   </div>

<partial name="~/Views/Miusuario/_ModalesCancelacion.cshtml" />

