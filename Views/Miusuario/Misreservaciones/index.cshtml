@*
 ============================================================================================
 Vista: Views/Miusuario/Misreservaciones/index.cshtml   —   GET /Miusuario/Misreservaciones
 Reservaciones de la cuenta en tres grupos: Próximos, Pasados y Cancelados (los calcula MisViajesService).
 Cada tarjeta es el parcial _TarjetaReservacion.cshtml; cancelar / reembolsar usa _ModalesCancelacion.cshtml.
 Internos: solo lectura (ven las tarjetas y el detalle, sin botones).
 ============================================================================================
*@
@model MisReservacionesViewModel
@{
    ViewData["Title"] = "Mis reservaciones";
    ViewData["Pestana"] = "reservaciones";
    ViewData["SoloLectura"] = Model.Contexto.SoloLectura;
    ViewData["Cliente"] = Model.Contexto.IdClienteVisto?.ToString();

    var grupos = new (string titulo, string id, List<ReservacionTarjetaViewModel> lista, string vacio)[]
    {
        ("Próximos", "viajes_proximos", Model.Proximas, "No tienes viajes próximos."),
        ("Pasados", "viajes_pasados", Model.Pasadas, "Aún no tienes viajes realizados."),
        ("Cancelados", "viajes_cancelados", Model.Canceladas, "No tienes reservaciones canceladas.")
    };
}

<div class="container mt-2">
    <h1 class="h3 mb-3">Mis reservaciones</h1>

    <partial name="~/Views/Miusuario/_CuentaNav.cshtml" model="Model.Contexto" />

    @if (Model.Proximas.Count + Model.Pasadas.Count + Model.Canceladas.Count == 0)
    {
        <div class="text-center py-5">
            <p class="fs-5 mb-3">Todavía no hay reservaciones en esta cuenta.</p>
            @if (!Model.Contexto.SoloLectura)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Buscar mi próximo viaje</a>
            }
        </div>
    }
    else
    {
        foreach (var grupo in grupos)
        {
            <section class="mb-5" aria-labelledby="@grupo.id">
                <h2 class="h4 mb-3" id="@grupo.id">@grupo.titulo <span class="badge text-bg-light">@grupo.lista.Count</span></h2>
                @if (grupo.lista.Count == 0)
                {
                    <p class="text-muted">@grupo.vacio</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var reservacion in grupo.lista)
                        {
                            <partial name="~/Views/Miusuario/_TarjetaReservacion.cshtml" model="reservacion" />
                        }
                    </div>
                }
            </section>
        }
    }
</div>

@if (!Model.Contexto.SoloLectura)
{
    <partial name="~/Views/Miusuario/_ModalesCancelacion.cshtml" />
}

@section Scripts {
    @if (!Model.Contexto.SoloLectura)
    {
        <script src="~/assets/js/script_R.js"></script>
    }
}
