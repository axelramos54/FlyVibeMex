@*
 ============================================================================================
 Vista: Views/Home/Hoteles.cshtml   —   GET /Home/Hoteles (HomeController.Hoteles())
 Pantalla del prototipo: Explorar y reservar › Hospedaje (+ Resultados)
 Página completa con Views/Shared/_Layout.cshtml (desde el 26-10-2026; antes era un fragmento de cargarPagina).
 Archivos asociados (convención de letras, H):
   - CSS: wwwroot/assets/css/style_H.css
   - JS : wwwroot/assets/js/script_H.js (actualmente vacío)
 Estado: maqueta estática. El buscador no envía datos y las tarjetas están escritas a mano.
 ============================================================================================
*@
@{
    ViewData["Title"] = "Hoteles";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/style_H.css">
}

@* Contenedor principal de la sección. Se estiliza por id (regla del equipo: class = Bootstrap, #id = estilo propio). *@
<div class="container mt-4" id="mapas_preferidos">
    <h1 class="page-title mb-4">Hoteles y Hospedaje</h1>

    <section class="row g-4" id="contenido">
        
        @* ---- Columna izquierda: formulario de búsqueda (destino, fecha de entrada, fecha de salida y huéspedes) ----
             NOTA: el <form> tiene action="#" y ningún <input> tiene atributo name, por lo que no se envía ningún dato.
                    Al pulsar el botón, el navegador navega a la URL actual y recarga el shell (vuelve a Inicio).
             NOTA : conectar a una acción GET de búsqueda (p. ej. con asp-action) y dar name a cada campo. *@
        <div class="col-12 col-lg-4 col-xl-3" id="buscador">
            <div class="search-card">
                <h2>Buscar Alojamiento</h2>
                <h2>En asociacion con: Umazingstay</h2>
                <form action="#" method="get">
                    <div class="form-group mb-3">
                        <label for="ubicacion">Alojamiento / Destino</label>
                        <input type="text" id="ubicacion" class="form-control"
                               placeholder="Ej. Cancún, Los Cabos, CDMX">
                    </div>

                    <div class="form-group mb-3">
                        <label for="fecha_inicio">Fecha de entrada</label>
                        <input type="date" id="fecha_inicio" class="form-control">
                    </div>

                    <div class="form-group mb-3">
                        <label for="fecha_final">Fecha de salida</label>
                        <input type="date" id="fecha_final" class="form-control">
                    </div>

                    <div class="form-group mb-4">
                        <label for="num_viajeros">Huéspedes</label>
                        <input type="number" id="num_viajeros" class="form-control" placeholder="1" min="1" value="2">
                    </div>

                    <button type="submit" class="btn btn-search-submit">Buscar hoteles</button>
                </form>
            </div>
        </div>

        @* ---- Columna derecha: resultados (#tarjetas) ----
             Tarjetas de DEMOSTRACIÓN escritas a mano: 3 hoteles (Cancún, Los Cabos, Oaxaca).
             NOTA: generar las tarjetas desde el servidor (bucle Razor sobre un ViewModel de resultados),
                   usando card.cshtml como referencia de diseño. *@
        <div class="col-12 col-lg-8 col-xl-9" id="tarjetas">
            <div class="row g-4">

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 mi-tarjeta">
                        <div class="card-img-wrapper">
                            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80"
                                 class="card-img-top" alt="Grand Oasis Cancún">
                            <div class="route-badge">
                                <span class="route-text">Cancún • 5★ All Inclusive</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Grand Oasis Cancún</h5>
                            <p class="card-text">Resort de playa con alberca estilo laguna, restaurantes de
                                especialidades y vista panorámica al mar Caribe.</p>
                                <div class="card-footer-box">
                                    <div class="price-box">
                                        <span class="price-label">Noche desde</span>
                                        <span class="price-value">$3,250 <small>MXN</small></span>
                                    </div>
                                    <a href="#" class="btn btn-card-action">Ver hotel</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 mi-tarjeta">
                            <div class="card-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80"
                                     class="card-img-top" alt="Pueblo Bonito Los Cabos">
                                <div class="route-badge">
                                    <span class="route-text">Los Cabos • Resort de Lujo</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">Pueblo Bonito Sunset</h5>
                                <p class="card-text">Ubicado en acantilados del Pacífico, ofrece suites privadas, spas
                                    exclusivos y atardeceres inolvidables.</p>
                                    <div class="card-footer-box">
                                        <div class="price-box">
                                            <span class="price-label">Noche desde</span>
                                            <span class="price-value">$4,890 <small>MXN</small></span>
                                        </div>
                                        <a href="#" class="btn btn-card-action">Ver hotel</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 mi-tarjeta">
                                <div class="card-img-wrapper">
                                    <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80"
                                         class="card-img-top" alt="Quinta Real Oaxaca">
                                    <div class="route-badge">
                                        <span class="route-text">Oaxaca • Boutique Histórico</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">Quinta Real Oaxaca</h5>
                                    <p class="card-text">Alojamiento único en un antiguo convento del siglo XVI situado en el
                                        corazón del centro histórico.</p>
                                        <div class="card-footer-box">
                                            <div class="price-box">
                                                <span class="price-label">Noche desde</span>
                                                <span class="price-value">$2,980 <small>MXN</small></span>
                                            </div>
                                            <a href="#" class="btn btn-card-action">Ver hotel</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </section>
    </div>

@section Scripts {
    <script src="~/assets/js/script_H.js"></script>
}
