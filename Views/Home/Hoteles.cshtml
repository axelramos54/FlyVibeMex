@*
 ============================================================================================
 Vista: Views/Home/Hoteles.cshtml   —   GET /Home/Hoteles (HomeController.Hoteles)
 Sección del catálogo: buscador (izquierda) + tarjetas con datos reales de la BD (derecha, _ResultadosCatalogo).
 El formulario es GET a la misma acción: la búsqueda queda en la URL (se puede recargar y compartir).
 Hospedaje: entrada, salida, huéspedes y habitaciones (cada habitación descuenta 1 del cupo de cada noche).
 Estilos: wwwroot/assets/css/busqueda.css (común a las 5 secciones del catálogo, T8.3).
 Validaciones: DataAnnotations + BusquedaCatalogoViewModel.Validar (fechas no pasadas, rango máximo de 30 días…).
 ============================================================================================
*@
@model BusquedaCatalogoViewModel
@{
    ViewData["Title"] = "Hoteles";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/busqueda.css" asp-append-version="true">
}

@* Contenedor principal de la sección. Se estiliza por id (regla del equipo: class = Bootstrap, #id = estilo propio). *@
<div class="container mt-4" id="mapas_preferidos">
    <h1 class="page-title mb-4">Hoteles y Hospedaje</h1>

    <section class="row g-4" id="contenido">

        @* ---- Columna izquierda: buscador ---- *@
        <div class="col-12 col-lg-4 col-xl-3" id="buscador">
            <div class="search-card">
                <h2>Buscar Alojamiento</h2>
                <h2>En asociacion con: Umazingstay</h2>
                <form asp-action="Hoteles" method="get" novalidate>
                    <div class="form-group mb-3">
                        <label asp-for="destino">Destino</label>
                        <select asp-for="destino" asp-items="Model.Destinos" class="form-select">
                            <option value="">Todos los destinos</option>
                        </select>
                        <span asp-validation-for="destino" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="desde">@TipoCatalogo.EtiquetaDesde(TipoCatalogo.Hospedaje)</label>
                        <input asp-for="desde" type="date" class="form-control" min="@hoy" />
                        <span asp-validation-for="desde" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="hasta">@TipoCatalogo.EtiquetaHasta(TipoCatalogo.Hospedaje)</label>
                        <input asp-for="hasta" type="date" class="form-control" min="@hoy" />
                        <span asp-validation-for="hasta" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="personas">@TipoCatalogo.EtiquetaPersonas(TipoCatalogo.Hospedaje)</label>
                        <input asp-for="personas" type="number" class="form-control" min="1" max="20" />
                        <span asp-validation-for="personas" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="habitaciones">Habitaciones</label>
                        <input asp-for="habitaciones" type="number" class="form-control" min="1" max="10" />
                        <span asp-validation-for="habitaciones" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="orden">Ordenar por</label>
                        <select asp-for="orden" asp-items="Html.GetEnumSelectList<OrdenCatalogo>()" class="form-select"></select>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="tipo_habitacion">Tipo de habitación</label>
                        <select asp-for="tipo_habitacion" class="form-select">
                            <option value="">Todos</option>
                            @foreach (var t in Model.TiposHabitacion)
                            {
                                <option value="@t" selected="@string.Equals(t, Model.tipo_habitacion, StringComparison.OrdinalIgnoreCase)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6"><label asp-for="precio_min">Precio mín.</label><input asp-for="precio_min" type="number" min="0" step="50" class="form-control" /></div>
                        <div class="col-6"><label asp-for="precio_max">Precio máx.</label><input asp-for="precio_max" type="number" min="0" step="50" class="form-control" />
                            <span asp-validation-for="precio_max" class="text-danger small"></span></div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="d-block mb-1">Características</label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var (clave, nombre) in EtiquetasHospedaje.Todas)
                            {
                                <input type="checkbox" class="btn-check" name="etiquetas" id="et_@clave" value="@clave"
                                    checked="@Model.etiquetas.Contains(clave)" autocomplete="off">
                                <label class="btn btn-sm btn-outline-primary" for="et_@clave">@nombre</label>
                            }
                        </div>
                    </div>
                    <button type="submit" class="btn btn-search-submit">Buscar hoteles</button>
                    <a asp-action="Hoteles" class="d-block text-center mt-2 small">Limpiar búsqueda</a>
                </form>
            </div>
        </div>

        @* ---- Columna derecha: resultados ---- *@
        <div class="col-12 col-lg-8 col-xl-9" id="tarjetas">
            <partial name="_ResultadosCatalogo" model="Model" />
        </div>

    </section>
        <div class="mt-5 mb-5" id="goldstay_seccion">
        <h2 class="h4 mb-3">También en GoldStay</h2>
        @* Widget de GoldStay: token de un solo uso, esta página no se puede cachear. *@
        <partial name="_WidgetFlyVibe" />
    </div>
</div>
