@*
 ============================================================================================
 Vista: Views/Home/Viajes.cshtml   —   GET /Home/Viajes (HomeController.Viajes)
 Sección del catálogo: buscador (izquierda) + tarjetas con datos reales de la BD (derecha, _ResultadosCatalogo).
 El formulario es GET a la misma acción: la búsqueda queda en la URL (se puede recargar y compartir).
 Vuelos: solo ida; la fecha es flexible (±3 días). El menú la llama "Vuelos" (acción Viajes, tipo VUELO).
 Archivos asociados (letra V): wwwroot/assets/css/style_V.css y wwwroot/assets/js/script_V.js.
 Validaciones: DataAnnotations + BusquedaCatalogoViewModel.Validar (fechas no pasadas, rango máximo de 30 días…).
 ============================================================================================
*@
@model BusquedaCatalogoViewModel
@{
    ViewData["Title"] = "Vuelos";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/style_V.css">
}

@* Contenedor principal de la sección. Se estiliza por id (regla del equipo: class = Bootstrap, #id = estilo propio). *@
<div class="container mt-4" id="mapas_preferidos">
    <h1 class="page-title mb-4">Vuelos y Viajes Disponibles</h1>

    <section class="row g-4" id="contenido">

        @* ---- Columna izquierda: buscador ---- *@
        <div class="col-12 col-lg-4 col-xl-3" id="buscador">
            <div class="search-card">
                <h2>Buscar vuelo</h2>
                <form asp-action="Viajes" method="get" novalidate>
                    <div class="form-group mb-3">
                        <label asp-for="origen">Origen</label>
                        <select asp-for="origen" asp-items="Model.Origenes" class="form-select">
                            <option value="">Cualquier origen</option>
                        </select>
                        <span asp-validation-for="origen" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="destino">Destino</label>
                        <select asp-for="destino" asp-items="Model.Destinos" class="form-select">
                            <option value="">Cualquier destino</option>
                        </select>
                        <span asp-validation-for="destino" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="desde">@TipoCatalogo.EtiquetaDesde(TipoCatalogo.Vuelo)</label>
                        <input asp-for="desde" type="date" class="form-control" min="@hoy" />
                        <span asp-validation-for="desde" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="personas">@TipoCatalogo.EtiquetaPersonas(TipoCatalogo.Vuelo)</label>
                        <input asp-for="personas" type="number" class="form-control" min="1" max="20" />
                        <span asp-validation-for="personas" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="orden">Ordenar por</label>
                        <select asp-for="orden" asp-items="Html.GetEnumSelectList<OrdenCatalogo>()" class="form-select"></select>
                    </div>
                    <button type="submit" class="btn btn-search-submit">Buscar vuelos</button>
                    <a asp-action="Viajes" class="d-block text-center mt-2 small">Limpiar búsqueda</a>
                </form>
            </div>
        </div>

        @* ---- Columna derecha: resultados ---- *@
        <div class="col-12 col-lg-8 col-xl-9" id="tarjetas">
            <partial name="_ResultadosCatalogo" model="Model" />
        </div>

    </section>
</div>

@section Scripts {
    <script src="~/assets/js/script_V.js"></script>
}
