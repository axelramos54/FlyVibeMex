@{
    ViewData["Title"] = "Viajes";
    Layout = null;
}

<link rel="stylesheet" href="~/assets/css/style_V.css">

<div class="container mt-4" id="mapas_preferidos">
    <h1 class="page-title mb-4">Vuelos y Viajes Disponibles</h1>

    <section class="row g-4" id="contenido">
        
        <div class="col-12 col-lg-4 col-xl-3" id="buscador">
            <div class="search-card">
                <h2>Buscar Viaje</h2>
                <form action="#" method="get">
                    <div class="form-group mb-3">
                        <label for="origen">Origen</label>
                        <input type="text" id="origen" class="form-control" placeholder="Ej. CDMX (MEX)">
                    </div>

                    <div class="form-group mb-3">
                        <label for="ubicacion">Destino</label>
                        <input type="text" id="ubicacion" class="form-control" placeholder="Ej. Cancún (CUN)">
                    </div>

                    <div class="form-group mb-3">
                        <label for="fecha_inicio">Fecha inicial</label>
                        <input type="date" id="fecha_inicio" class="form-control">
                    </div>

                    <div class="form-group mb-3">
                        <label for="fecha_final">Fecha final</label>
                        <input type="date" id="fecha_final" class="form-control">
                    </div>

                    <div class="form-group mb-4">
                        <label for="num_viajeros">Pasajeros</label>
                        <input type="number" id="num_viajeros" class="form-control" placeholder="1" min="1" value="1">
                    </div>

                    <button type="submit" class="btn btn-search-submit">Buscar ofertas</button>
                </form>
            </div>
        </div>

        <div class="col-12 col-lg-8 col-xl-9" id="tarjetas">
            <div class="row g-4">

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 mi-tarjeta">
                        <div class="card-img-wrapper">
                            <img src="https://images.unsplash.com/photo-1552074284-5e88ef1aef18?auto=format&fit=crop&w=600&q=80"
                                 class="card-img-top" alt="Cancún">
                            <div class="route-badge">
                                <span class="route-text">CDMX ✈ Cancún</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Cancún & Riviera Maya</h5>
                            <p class="card-text">Disfruta de las playas del Caribe Mexicano con vuelo redondo y
                                hospedaje todo incluido frente al mar.</p>
                                <div class="card-footer-box">
                                    <div class="price-box">
                                        <span class="price-label">Desde</span>
                                        <span class="price-value">$8,499 <small>MXN</small></span>
                                    </div>
                                    <a href="#" class="btn btn-card-action">Ver vuelo</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 mi-tarjeta">
                            <div class="card-img-wrapper">
                                <img src="https://cdn.sanity.io/images/esqfj3od/production/c1c9069644295a989eaa58f5f18fa124eb438379-1080x720.webp?w=828&q=65&fit=clip&auto=format"
                                     class="card-img-top" alt="Los Cabos">
                                <div class="route-badge">
                                    <span class="route-text">GDL ✈ Los Cabos</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">Los Cabos Escape</h5>
                                <p class="card-text">Relájate en resorts de lujo donde el desierto se une con el mar.
                                    Incluye renta de auto y vuelo directo.</p>
                                    <div class="card-footer-box">
                                        <div class="price-box">
                                            <span class="price-label">Desde</span>
                                            <span class="price-value">$12,850 <small>MXN</small></span>
                                        </div>
                                        <a href="#" class="btn btn-card-action">Ver vuelo</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 mi-tarjeta">
                                <div class="card-img-wrapper">
                                    <img src="https://images.unsplash.com/photo-1512813195386-6cf811ad3542?auto=format&fit=crop&w=600&q=80"
                                         class="card-img-top" alt="Oaxaca">
                                    <div class="route-badge">
                                        <span class="route-text">MTY ✈ Oaxaca</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">Oaxaca Cultural</h5>
                                    <p class="card-text">Sumérgete en la cultura, zonas arqueológicas y gastronomía tradicional
                                        de uno de los estados más ricos de México.</p>
                                        <div class="card-footer-box">
                                            <div class="price-box">
                                                <span class="price-label">Desde</span>
                                                <span class="price-value">$4,920 <small>MXN</small></span>
                                            </div>
                                            <a href="#" class="btn btn-card-action">Ver vuelo</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

<script src="~/assets/js/script_V.js"></script>