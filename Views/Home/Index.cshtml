@*
 ============================================================================================
 Vista: Views/Home/Index.cshtml   —   GET / y /Home/Index (HomeController.Index())
 Pantalla del prototipo: Home / Explorar (pantalla de Inicio que se muestra al abrir el sitio).
 Página completa con Views/Shared/_Layout.cshtml (desde el 26-10-2026; antes era un fragmento de cargarPagina).
 Estilos: wwwroot/assets/css/style_D.css.
 Estado: los textos y las imágenes los edita el SA en Contenido del sitio › Inicio (IContenidoSitioService;
 si no hay nada guardado se muestran los textos de siempre, definidos en Models/ContenidoSitioClaves.cs).
 ============================================================================================
*@
@inject IContenidoSitioService ContenidoServicio
@{
    ViewData["Title"] = "Inicio";
    var c = await ContenidoServicio.ObtenerAsync();
    // Las 4 tarjetas de categorías: clave del contenido, id del HTML, acción del enlace y texto del botón.
    var tarjetas = new[]
    {
        ("vuelos", "Viajes_card", "Viajes", "Ver viajes"),
        ("paquetes", "Paquete_card", "Paquetes", "Ver paquetes"),
        ("hospedaje", "Hospedaje_card", "Hoteles", "Ver hoteles"),
        ("tours", "Tour_card", "Tours", "Ver tours")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/style_D.css">
}

<div class="container mt-4" id="mapas_preferidos">

    @* ---- Bienvenida ---- *@
    <section id="seccion_bienvenida">
        <div class="d-flex flex-column flex-md-row gap-3 mb-3 align-items-center">
            <div class="w-100 bg-infor">
                <h2>@c.Texto(ContenidoSitioClaves.BienvenidaTitulo)</h2>
            </div>

            <div class="w-100 bg-alert">
                <p style="white-space: pre-line">@c.Texto(ContenidoSitioClaves.BienvenidaTexto)</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Paquetes" class="btn btn-hero-primary">Explorar opciones</a>
            <a asp-controller="Miusuario" asp-action="Misreservaciones" class="btn btn-hero-outline">Mis Viajes</a>
        </div>
    </section>

    @* ---- Tarjetas de categorías: Vuelos (Viajes), Paquetes, Hospedaje (Hoteles) y Tours ----
         Título, texto e imagen de cada una se editan en el panel SA. NOTA: falta la tarjeta de Vehículos. *@
    <section id="seccion_general" class="mt-4">
        <div class="row g-4">
            @foreach (var (clave, idHtml, accion, boton) in tarjetas)
            {
                var titulo = c.Texto(ContenidoSitioClaves.TarjetaTitulo(clave));
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card h-100 mi-tarjeta" id="@idHtml">
                        <img src="@c.Imagen(ContenidoSitioClaves.TarjetaImagen(clave))" class="card-img-top object-fit-cover"
                             style="height: 180px" alt="@titulo">
                        <div class="card-body">
                            <h5 class="card-title">@titulo</h5>
                            <p class="card-text" style="white-space: pre-line">@c.Texto(ContenidoSitioClaves.TarjetaTexto(clave))</p>
                            <a asp-controller="Home" asp-action="@accion" class="btn btn-card-action">@boton</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    @* ---- Banner de promociones (texto editable). Las promociones no se anuncian: el cliente escribe el código. *@
    <section id="seccion_promociones" class="mt-4">
        <div class="promo-content">
            <h2>@c.Texto(ContenidoSitioClaves.PromoTitulo)</h2>
            <p style="white-space: pre-line">@c.Texto(ContenidoSitioClaves.PromoTexto)</p>
        </div>
    </section>

    @* ---- Bloque de contacto (texto editable) ---- *@
    <section id="seccion_contactanos" class="mt-4">
        <h2>@c.Texto(ContenidoSitioClaves.ContactoTitulo)</h2>
        <p style="white-space: pre-line">@c.Texto(ContenidoSitioClaves.ContactoTexto)</p>
        <a asp-controller="Solicitar" asp-action="Index" class="btn btn-outline-primary">Solicitar asistencia</a>
    </section>

</div>
