@{
    ViewData["Title"] = "Tours";
    Layout = null;
}

<link rel="stylesheet" href="~/assets/css/style_T.css">

<div class="container mt-4" id="mapas_preferidos">
    <h1 class="page-title mb-4">Tours y Experiencias</h1>

    <section class="row g-4" id="contenido">
        
        <div class="col-12 col-lg-4 col-xl-3" id="buscador">
            <div class="search-card">
                <h2>Buscar Tour</h2>
                <form action="#" method="get">
                    <div class="form-group mb-3">
                        <label for="ubicacion">Nombre o destino</label>
                        <input type="text" id="ubicacion" class="form-control" placeholder="Ej. Chichén Itzá, Tulum">
                    </div>

                    <div class="form-group mb-3">
                        <label for="fecha_inicio">Fecha inicial</label>
                        <input type="date" id="fecha_inicio" class="form-control">
                    </div>

                    <div class="form-group mb-3">
                        <label for="fecha_final">Fecha final</label>
                        <input type="date" id="fecha_final" class="form-control">
                    </div>

                    <div class="form-group mb-4">
                        <label for="num_viajeros">Personas</label>
                        <input type="number" id="num_viajeros" class="form-control" placeholder="1" min="1" value="1">
                    </div>

                    <button type="submit" class="btn btn-search-submit">Buscar experiencias</button>
                </form>
            </div>
        </div>

        <div class="col-12 col-lg-8 col-xl-9" id="tarjetas">
            <div class="row g-4">

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 mi-tarjeta">
                        <div class="card-img-wrapper">
                            <img src="https://images.unsplash.com/photo-1518638150340-f706e86654de?auto=format&fit=crop&w=600&q=80"
                                 class="card-img-top" alt="Chichén Itzá">
                            <div class="route-badge">
                                <span class="route-text">Yucatán • Tour de 1 día</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Chichén Itzá & Cenote</h5>
                            <p class="card-text">Explora una de las 7 maravillas del mundo moderno con guía certificado,
                                comida buffet y nado en cenote sagrado.</p>
                                <div class="card-footer-box">
                                    <div class="price-box">
                                        <span class="price-label">Por persona</span>
                                        <span class="price-value">$1,450 <small>MXN</small></span>
                                    </div>
                                    <a href="#" class="btn btn-card-action">Ver tour</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 mi-tarjeta">
                            <div class="card-img-wrapper">
                                <img src="https://lavidasondosviajes.com/wp-content/uploads/2022/06/ruinas-que-ver-en-tulum.jpg"
                                     class="card-img-top" alt="Tulum y Arrecife">
                                <div class="route-badge">
                                    <span class="route-text">Tulum • Acuático</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">Tulum & Snorkel Maya</h5>
                                <p class="card-text">Recorre las míticas ruinas arqueológicas frente al mar y nada entre
                                    tortugas marinas en el arrecife de Akumal.</p>
                                    <div class="card-footer-box">
                                        <div class="price-box">
                                            <span class="price-label">Por persona</span>
                                            <span class="price-value">$1,890 <small>MXN</small></span>
                                        </div>
                                        <a href="#" class="btn btn-card-action">Ver tour</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 mi-tarjeta">
                                <div class="card-img-wrapper">
                                    <img src="https://travelgrafia.co/wp-content/uploads/2025/04/Miradores-Canon-del-Sumidero-Mexico.webp"
                                         class="card-img-top" alt="Cañón del Sumidero">
                                    <div class="route-badge">
                                        <span class="route-text">Chiapas • Naturaleza</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">Cañón del Sumidero</h5>
                                    <p class="card-text">Navega en lancha por las imponentes paredes del cañón y visita el
                                        pintoresco Pueblo Mágico de Chiapa de Corzo.</p>
                                        <div class="card-footer-box">
                                            <div class="price-box">
                                                <span class="price-label">Por persona</span>
                                                <span class="price-value">$1,200 <small>MXN</small></span>
                                            </div>
                                            <a href="#" class="btn btn-card-action">Ver tour</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </section>
            </div>

<script src="~/assets/js/script_T.js"></script>