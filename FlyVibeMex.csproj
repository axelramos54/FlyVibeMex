<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Identificador de `dotnet user-secrets` (equivale a ejecutar `dotnet user-secrets init`).
      NO es un secreto: solo indica en qué carpeta de TU usuario de Windows se guardan los secretos
      (%APPDATA%\Microsoft\UserSecrets\<UserSecretsId>\secrets.json), fuera del repositorio.
    -->
    <UserSecretsId>flyvibemex-9b6d9483-4ded-4987-a992-d9edf61e015e</UserSecretsId>
    <!--
      Las imágenes que se suben desde el panel (wwwroot/uploads) son DATOS, no código: se excluyen del proyecto para que
      `dotnet watch` no reinicie la app cada vez que alguien sube una foto (y no falle su recarga en caliente).
      Las sirve Program.cs con UseStaticFiles mientras la app corre, así que en el sitio y en el bot se siguen viendo.
      Nota: por lo mismo, `dotnet publish` no las copia; en un servidor la carpeta uploads se respalda aparte.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/uploads/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- ORM oficial: Entity Framework Core para SQL Server (.NET 10). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Herramientas de diseño (Add-Migration, Scaffold-DbContext). Solo en desarrollo; no se publican. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Seguridad (NU1902 / NU1903): System.Security.Cryptography.Pkcs llega como dependencia indirecta de
      Microsoft.Data.SqlClient en la versión 9.0.11, que tiene dos vulnerabilidades de denegación de servicio
      (GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7). La referencia directa obliga a usar la versión corregida.
      Se puede quitar cuando EF Core / SqlClient ya traigan una versión corregida por su cuenta.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Bot de Telegram (docs/06): cliente oficial de la comunidad para la Bot API. El token va en dotnet user-secrets. -->
    <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
  </ItemGroup>

</Project>
